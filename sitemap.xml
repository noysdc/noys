---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.posts %}
{%- unless p.sitemap == false %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endunless %}
{%- endfor %}
{%- for p in site.pages %}
{%- unless p.sitemap == false or p.noindex or p.url contains "." %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
